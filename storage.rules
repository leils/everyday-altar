rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /entries/{allPaths=**} {
      // Anyone can read post images.
      allow read: if true;

      // Writes restricted to the owner. Replace YOUR_OWNER_EMAIL with your email address.
      allow write: if request.auth != null
                   && request.auth.token.email == "e.leiachang@gmail.com";
    }

  }
}
