rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /entries/{entryId} {
      // Anyone can read entries.
      allow read: if true;

      // Writes are restricted to the owner. Replace YOUR_OWNER_EMAIL with your email address.
      // This covers the Apple Shortcuts flow (Firebase email/password auth → ID token → REST API)
      // as well as any future write page using the same auth.
      allow write: if request.auth != null
                   && request.auth.token.email == "YOUR_OWNER_EMAIL";
    }

  }
}
